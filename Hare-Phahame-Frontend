<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Travel Posts</title>
  <style>
   body {
      font-family: Arial, sans-serif;
      background: linear-gradient(to bottom, #3b0ca0, #b83280);
      color: #fff;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100vh;
      margin: 0;
    }

    .logo {
      width: 200px;
      margin-bottom: 20px;
    }

    .form-container {
      background: #ffffff22;
      padding: 30px;
      border-radius: 20px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.4);
      width: 300px;
    }

    input {
      width: 100%;
      padding: 10px;
      margin-top: 10px;
      border: none;
      border-radius: 10px;
    }

    button {
      background-color: #4b0082;
      color: #fff;
      padding: 10px;
      border: none;
      width: 100%;
      border-radius: 10px;
      margin-top: 15px;
      cursor: pointer;
    }

    .error {
      color: #ff4d4d;
      margin-top: 10px;
    }
  </style>
</head>
<body>
  <h2>Create a Travel Post</h2>
  <input id="user" placeholder="Your Name"><br><br>
  <input id="destination" placeholder="Where are you going?"><br><br>
  <input id="time" placeholder="What time are you leaving?"><br><br>
  <button onclick="createPost()">Post</button>

  <h2>All Posts</h2>
  <div id="posts"></div>

  <script>
    async function createPost() {
      const post = {
        user: document.getElementById('user').value,
        destination: document.getElementById('destination').value,
        time: document.getElementById('time').value,
      };
      await fetch('http://localhost:3000/posts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(post),
      });
      loadPosts();
    }

    async function loadPosts() {
      const res = await fetch('http://localhost:3000/posts');
      const posts = await res.json();
      const container = document.getElementById('posts');
      container.innerHTML = '';

      posts.forEach(post => {
        const div = document.createElement('div');
        div.className = 'post';
        div.innerHTML = `
          <strong>${post.user}</strong> is going to <strong>${post.destination}</strong> at <strong>${post.time}</strong><br>
          Viewed by: ${post.views.join(', ') || 'No one yet'}<br><br>
          Replies:<br>
          ${post.replies.map(r => <div class="reply">${r.user}: ${r.text}</div>).join('')}
          <br>
          <input placeholder="Your Name" id="viewer-${post._id}">
          <button onclick="viewPost('${post._id}')">View</button><br>
          <input placeholder="Reply" id="reply-${post._id}">
          <button onclick="replyPost('${post._id}')">Reply</button>
        `;
        container.appendChild(div);
      });
    }

    async function viewPost(postId) {
      const username = document.getElementById(viewer-${postId}).value;
      await fetch(http://localhost:3000/posts/${postId}/view, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username }),
      });
      loadPosts();
    }

    async function replyPost(postId) {
      const user = document.getElementById(viewer-${postId}).value;
      const text = document.getElementById(reply-${postId}).value;
      await fetch(http://localhost:3000/posts/${postId}/reply, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ user, text }),
      });
      loadPosts();
    }

    loadPosts();
  </script>
</body>
</html>
